{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hv-vertex",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-30",
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hr@hvvertex.in"],
      "allowed_destination_addresses": ["hr@hvvertex.in"],
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "STUDENT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "CAREER_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
